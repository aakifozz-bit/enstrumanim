{
 "s01_hook": [
  {
   "start": 0.0,
   "end": 3.506,
   "text": "Düşünsenize: hiç çalmadığı bir gitarı eline alıyor ve ilk denemede,"
  },
  {
   "start": 3.773,
   "end": 5.87,
   "text": "albümün kaderini belirleyen bir solo çalıyor."
  },
  {
   "start": 6.03,
   "end": 9.91,
   "text": "Hans Zimmer ona yazınca, mesajı sahte sanıp az kalsın geri çeviriyor."
  },
  {
   "start": 10.07,
   "end": 13.781,
   "text": "Üstelik kendi deyişiyle, hayatında tek bir gitar dersi bile almamış."
  },
  {
   "start": 13.99,
   "end": 14.402,
   "text": "Kim mi?"
  },
  {
   "start": 14.58,
   "end": 15.237,
   "text": "Karşınızda..."
  },
  {
   "start": 15.48,
   "end": 16.189,
   "text": "Guthrie Govan!"
  }
 ],
 "s02_cocukluk": [
  {
   "start": 0.0,
   "end": 2.195,
   "text": "Her şey 27 Aralık 1971'de,"
  },
  {
   "start": 2.543,
   "end": 5.23,
   "text": "İngiltere'nin Essex bölgesindeki Chelmsford'da başlıyor."
  },
  {
   "start": 5.39,
   "end": 8.03,
   "text": "Babasının ucuz, naylon telli bir gitarı var."
  },
  {
   "start": 8.19,
   "end": 11.9,
   "text": "Glasgow'lu babası birkaç akor biliyor, ama hepsini oğluna öğretiyor."
  },
  {
   "start": 12.06,
   "end": 14.152,
   "text": "Guthrie kaç yaşında başladığını hatırlamıyor;"
  },
  {
   "start": 14.613,
   "end": 16.396,
   "text": "anlatılanlara göre 3 yaşındaymış."
  },
  {
   "start": 16.6,
   "end": 18.016,
   "text": "5 yaşında ilk kez sahnede:"
  },
  {
   "start": 18.426,
   "end": 21.746,
   "text": "babasının iş arkadaşlarının grubuyla Elvis ve Chuck Berry çalıyor."
  },
  {
   "start": 21.91,
   "end": 22.865,
   "text": "Ya 9 yaşında?"
  },
  {
   "start": 23.07,
   "end": 25.14,
   "text": "Kardeşi Seth'le ulusal televizyonda!"
  }
 ],
 "s03_kulak": [
  {
   "start": 0.0,
   "end": 2.799,
   "text": "İnternet yok, tablatür yok, öğretmen yok."
  },
  {
   "start": 3.0,
   "end": 4.07,
   "text": "Peki nasıl öğreniyor?"
  },
  {
   "start": 4.23,
   "end": 4.754,
   "text": "Kulaktan!"
  },
  {
   "start": 4.99,
   "end": 8.015,
   "text": "Ailesinin plak koleksiyonunu tek tek çözüyor: Elvis,"
  },
  {
   "start": 8.23,
   "end": 11.795,
   "text": "Beatles, Hendrix, Cream, hatta bir Joe Pass caz plağı."
  },
  {
   "start": 12.01,
   "end": 15.36,
   "text": "Kendini, duyduğu her sesi taklit eden lir kuşuna benzetiyor."
  },
  {
   "start": 15.52,
   "end": 18.114,
   "text": "Babasının tavsiyesi ise şu: 'Hissederek çal."
  },
  {
   "start": 18.3,
   "end": 20.792,
   "text": "Zamanlama, ne kadar bildiğinden daha önemli.'"
  }
 ],
 "s04_oxford": [
  {
   "start": 0.0,
   "end": 2.174,
   "text": "Okulda shred gitaristlerini keşfediyor."
  },
  {
   "start": 2.4,
   "end": 4.216,
   "text": "Bir okul arkadaşı da Tom Jenkinson;"
  },
  {
   "start": 4.585,
   "end": 7.638,
   "text": "yani ileride elektronik müziğin kült ismi olacak Squarepusher."
  },
  {
   "start": 7.8,
   "end": 10.743,
   "text": "Sonra Oxford'da İngiliz dili ve edebiyatı okumaya başlıyor,"
  },
  {
   "start": 11.173,
   "end": 12.79,
   "text": "ama yarıda bırakıp müziği seçiyor."
  },
  {
   "start": 12.95,
   "end": 13.792,
   "text": "20 yaşlarında,"
  },
  {
   "start": 13.997,
   "end": 16.057,
   "text": "shred dünyasının efsanevi plak şirketi"
  },
  {
   "start": 16.067,
   "end": 17.92,
   "text": "Shrapnel'den anlaşma teklifi geliyor."
  },
  {
   "start": 18.08,
   "end": 19.28,
   "text": "Ve Govan... reddediyor!"
  },
  {
   "start": 19.44,
   "end": 22.301,
   "text": "Tek bilmek istediği, yeterince iyi olup olmadığıymış."
  }
 ],
 "s05_goty": [
  {
   "start": 0.0,
   "end": 3.27,
   "text": "Ama faturalar beklemiyor; bir süre McDonald's'ta çalışıyor."
  },
  {
   "start": 3.43,
   "end": 6.783,
   "text": "1993'te Guitarist dergisinin 'Yılın Gitaristi' yarışmasına"
  },
  {
   "start": 6.793,
   "end": 9.58,
   "text": "Wonderful Slippery Thing adlı bestesiyle katılıyor."
  },
  {
   "start": 9.74,
   "end": 11.382,
   "text": "Demosu onu canlı finale taşıyor"
  },
  {
   "start": 11.392,
   "end": 13.97,
   "text": "ve hamburger çeviren bu genç... finali kazanıyor!"
  },
  {
   "start": 14.13,
   "end": 15.014,
   "text": "Fitil ateşlendi."
  }
 ],
 "s06_ogretmen": [
  {
   "start": 0.0,
   "end": 1.221,
   "text": "Ödül kapıları açıyor."
  },
  {
   "start": 1.49,
   "end": 4.464,
   "text": "1994'ten itibaren Guitar Techniques dergisi için"
  },
  {
   "start": 4.474,
   "end": 7.199,
   "text": "Hank Marvin'den Shawn Lane'e kadar herkesi notaya döküyor,"
  },
  {
   "start": 7.445,
   "end": 8.398,
   "text": "dersler hazırlıyor."
  },
  {
   "start": 8.57,
   "end": 11.523,
   "text": "ACM ve BIMM gibi okullarda binlerce öğrenciye ilham veriyor,"
  },
  {
   "start": 11.83,
   "end": 13.562,
   "text": "Creative Guitar kitaplarını yazıyor."
  },
  {
   "start": 13.73,
   "end": 17.22,
   "text": "Yani birçok gitarist onu önce sahneden değil, dergiden tanıyor!"
  }
 ],
 "s07_asia": [
  {
   "start": 0.0,
   "end": 2.543,
   "text": "Derken sürpriz bir kapı açılıyor: Asia!"
  },
  {
   "start": 2.74,
   "end": 5.303,
   "text": "ACM'deki bir meslektaşının tavsiyesiyle 2001"
  },
  {
   "start": 5.314,
   "end": 7.43,
   "text": "albümü Aura'da çalıyor ve gruba katılıyor."
  },
  {
   "start": 7.59,
   "end": 10.737,
   "text": "Asia'nın orijinal kadrosu yeniden birleşince Govan boş durmuyor:"
  },
  {
   "start": 11.158,
   "end": 13.432,
   "text": "John Payne ve Jay Schellen'le GPS'i kuruyor."
  },
  {
   "start": 13.6,
   "end": 14.916,
   "text": "Bir yandan da The Young Punx'la"
  },
  {
   "start": 14.926,
   "end": 16.87,
   "text": "ve Dizzee Rascal'ın sahnesinde çalıyor."
  }
 ],
 "s08_erotic": [
  {
   "start": 0.0,
   "end": 0.973,
   "text": "Peki solo albüm?"
  },
  {
   "start": 1.17,
   "end": 3.334,
   "text": "Govan'a kalırsa, kimse ilgilenmez."
  },
  {
   "start": 3.57,
   "end": 5.252,
   "text": "Ama amfi üreticisi Paul Cornford,"
  },
  {
   "start": 5.457,
   "end": 7.506,
   "text": "sırf bu albüm için bir plak şirketi kuruyor"
  },
  {
   "start": 7.517,
   "end": 9.822,
   "text": "ve gitarları Richie Kotzen'in Los Angeles'taki"
  },
  {
   "start": 9.832,
   "end": 11.123,
   "text": "stüdyosunda kaydettiriyor."
  },
  {
   "start": 11.29,
   "end": 16.486,
   "text": "2006'da Erotic Cakes çıkıyor; basta kardeşi Seth, davulda Pete Riley."
  },
  {
   "start": 16.71,
   "end": 17.806,
   "text": "İsim garip mi geldi?"
  },
  {
   "start": 18.0,
   "end": 20.33,
   "text": "The Simpsons'ta Homer'ın rastladığı bir dükkândan!"
  }
 ],
 "s09_aristocrats": [
  {
   "start": 0.0,
   "end": 2.123,
   "text": "Ocak 2011, NAMM fuarı."
  },
  {
   "start": 2.33,
   "end": 4.658,
   "text": "Basçı Bryan Beller ve davulcu Marco Minnemann,"
  },
  {
   "start": 4.914,
   "end": 7.414,
   "text": "Bass Bash gecesinde 30 dakikalık bir set çalacak."
  },
  {
   "start": 7.61,
   "end": 9.85,
   "text": "Ama gitarist Greg Howe son anda çekiliyor."
  },
  {
   "start": 10.01,
   "end": 10.942,
   "text": "Şimdi ne olacak?"
  },
  {
   "start": 11.14,
   "end": 13.19,
   "text": "Fuarda zaten bulunan Govan çağrılıyor."
  },
  {
   "start": 13.35,
   "end": 14.346,
   "text": "Prova neredeyse yok,"
  },
  {
   "start": 14.561,
   "end": 16.856,
   "text": "ama sahneden inerken üçü de aynı şeyi söylüyor:"
  },
  {
   "start": 17.143,
   "end": 18.926,
   "text": "'Bu iş oluyor, bunu kaydetmeliyiz!'"
  },
  {
   "start": 19.14,
   "end": 20.587,
   "text": "The Aristocrats böyle doğuyor."
  },
  {
   "start": 20.84,
   "end": 24.428,
   "text": "5 stüdyo albümü, yüzlerce konser, İstanbul dahil."
  },
  {
   "start": 24.63,
   "end": 28.085,
   "text": "Son albüm Duck ise penguen polisinden kaçan bir ördeğin hikâyesi!"
  }
 ],
 "s10_wilson": [
  {
   "start": 0.0,
   "end": 2.154,
   "text": "Porcupine Tree'nin kurucusu Steven Wilson,"
  },
  {
   "start": 2.42,
   "end": 4.274,
   "text": "onu yeni solo albümü için çağırıyor."
  },
  {
   "start": 4.44,
   "end": 6.829,
   "text": "Eylül 2012, Los Angeles."
  },
  {
   "start": 7.07,
   "end": 10.371,
   "text": "The Raven That Refused to Sing neredeyse tamamen canlı kaydediliyor."
  },
  {
   "start": 10.6,
   "end": 11.196,
   "text": "Stüdyoda,"
  },
  {
   "start": 11.432,
   "end": 14.51,
   "text": "Govan'ın daha önce hiç çalmadığı Jazzmaster tarzı bir gitar var."
  },
  {
   "start": 14.67,
   "end": 16.547,
   "text": "Gitarı eline alıyor ve ilk çaldığı şey,"
  },
  {
   "start": 16.844,
   "end": 18.58,
   "text": "Drive Home'un final solosu oluyor."
  },
  {
   "start": 18.74,
   "end": 22.072,
   "text": "Evet, yanlış duymadınız: ilk sefer, ilk kayıt!"
  },
  {
   "start": 22.29,
   "end": 24.28,
   "text": "Wilson'ın yorumu: 'Delilik değil mi?'"
  },
  {
   "start": 24.46,
   "end": 27.42,
   "text": "Ardından Hand. Cannot. Erase. geliyor."
  }
 ],
 "s11_zimmer": [
  {
   "start": 0.0,
   "end": 1.77,
   "text": "Bir gün Facebook'tan mesaj geliyor."
  },
  {
   "start": 1.93,
   "end": 4.145,
   "text": "Gönderen, Hans Zimmer olduğunu söylüyor."
  },
  {
   "start": 4.32,
   "end": 5.469,
   "text": "Govan'ın cevabına bakın:"
  },
  {
   "start": 5.9,
   "end": 8.953,
   "text": "'Muhtemelen e-posta adresimi arayan 14 yaşında bir çocuksun,"
  },
  {
   "start": 9.138,
   "end": 10.008,
   "text": "vaktimi harcama.'"
  },
  {
   "start": 10.22,
   "end": 13.675,
   "text": "Yanıt: 'Gerçekten benim, şu şüpheli Alman film bestecisi."
  },
  {
   "start": 13.88,
   "end": 16.351,
   "text": "Seni YouTube'da perdesiz gitar çalarken buldum.'"
  },
  {
   "start": 16.6,
   "end": 18.979,
   "text": "2016'dan beri Hans Zimmer Live'da!"
  },
  {
   "start": 19.17,
   "end": 20.44,
   "text": "Ya Dune'daki gaydalar?"
  },
  {
   "start": 20.61,
   "end": 22.538,
   "text": "Zimmer'a göre aslında Govan'ın gitarı."
  },
  {
   "start": 22.72,
   "end": 25.212,
   "text": "Yönetmen Denis Villeneuve'e söylemeyi bile unutmuş!"
  }
 ],
 "s12_stil": [
  {
   "start": 0.0,
   "end": 1.499,
   "text": "Govan müziği bir dil gibi görüyor:"
  },
  {
   "start": 1.817,
   "end": 3.66,
   "text": "'Müzik ya ana diliniz gibi hissettirir"
  },
  {
   "start": 3.671,
   "end": 5.8,
   "text": "ya da okulda öğrendiğiniz bir yabancı dil gibi."
  },
  {
   "start": 6.01,
   "end": 8.282,
   "text": "Ben hep ana dilim gibi hissettirsin istedim.'"
  },
  {
   "start": 8.48,
   "end": 9.61,
   "text": "Teknik cephaneliği mi?"
  },
  {
   "start": 9.77,
   "end": 12.985,
   "text": "Devasa: akışkan legato, birkaç parmakla tapping,"
  },
  {
   "start": 13.25,
   "end": 14.765,
   "text": "country usulü hybrid picking,"
  },
  {
   "start": 15.061,
   "end": 17.869,
   "text": "perdesiz gitar ve neredeyse hiç bırakmadığı volume pedalı."
  },
  {
   "start": 18.08,
   "end": 21.475,
   "text": "Ama ona sorarsanız: 'Shred ne çirkin bir kelime, değil mi?'"
  },
  {
   "start": 21.66,
   "end": 22.714,
   "text": "Çok nota çalıyorsa,"
  },
  {
   "start": 23.0,
   "end": 25.924,
   "text": "kafasındaki müzik gerçekten o kadar nota içerdiği için."
  }
 ],
 "s13_ekipman": [
  {
   "start": 0.0,
   "end": 0.873,
   "text": "Gelelim ekipmana:"
  },
  {
   "start": 1.221,
   "end": 4.29,
   "text": "elinde genelde 2014'te çıkan Charvel imza modeli var."
  },
  {
   "start": 4.45,
   "end": 6.368,
   "text": "Yıllarca Victory lambalı amfilerle çaldı;"
  },
  {
   "start": 6.624,
   "end": 8.827,
   "text": "Hans Zimmer turneleri onu dijitale yöneltti:"
  },
  {
   "start": 9.227,
   "end": 11.78,
   "text": "bugün sahnede tamamen Fractal işlemci kullanıyor!"
  }
 ],
 "s14_miras": [
  {
   "start": 0.0,
   "end": 3.26,
   "text": "Bryan Beller şöyle özetliyor: 'Dünyanın en iyi gitaristinin,"
  },
  {
   "start": 3.455,
   "end": 5.176,
   "text": "Chelmsford'daki bir mekânda her hafta sonu"
  },
  {
   "start": 5.187,
   "end": 7.41,
   "text": "çaldığından dünyanın geri kalanının haberi yoktu.'"
  },
  {
   "start": 7.62,
   "end": 8.47,
   "text": "Ama artık var!"
  },
  {
   "start": 8.63,
   "end": 11.265,
   "text": "2026'da Karnivool'un yeni albümünde solo çaldı;"
  },
  {
   "start": 11.747,
   "end": 14.339,
   "text": "The Aristocrats ise Duck turnesini Avrupa'da tamamladı."
  }
 ],
 "s15_kapanis": [
  {
   "start": 0.0,
   "end": 2.338,
   "text": "Peki o, dünyanın en iyi gitaristi mi?"
  },
  {
   "start": 2.52,
   "end": 5.708,
   "text": "Kendisine sorarsanız: 'Değilim, olmaya da çalışmıyorum."
  },
  {
   "start": 5.91,
   "end": 8.515,
   "text": "Sadece olabileceğim en iyi ben olmaya çalışıyorum.'"
  },
  {
   "start": 8.71,
   "end": 11.325,
   "text": "Şimdi Drive Home'u açın ve o son soloyu dinleyin."
  },
  {
   "start": 11.51,
   "end": 13.43,
   "text": "Ve unutmayın... ilk denemeydi!"
  }
 ]
}